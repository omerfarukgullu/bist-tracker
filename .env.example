# Bu dosyayı .env olarak kopyala ve gerçek değerleri gir.
# .env asla git'e eklenmez (bkz. .gitignore).

# BotFather'dan alınan token
TELEGRAM_BOT_TOKEN=

# Telegram sohbet id'si (README'de nasıl bulunur anlatılıyor)
TELEGRAM_CHAT_ID=

# setWebhook çağrısında Telegram'a verilecek rastgele secret (opsiyonel ama önerilir)
TELEGRAM_WEBHOOK_SECRET=

# /api/refresh endpoint'ini tetiklemek için gereken bearer token (kendin üret, ör. bir UUID)
REFRESH_TOKEN=

# Flask oturum çerezlerini imzalamak için (boşsa otomatik üretilip yerel
# secret_key.txt dosyasında saklanır — kalıcı disk olmayan ortamlarda
# (ör. Render free plan) elle set etmen önerilir, aksi halde her restart'ta
# oturumlar düşer).
SECRET_KEY=

# Claude API key (opsiyonel) — girilirse her hisse için AI destekli veri
# sentezi paragrafı üretilir. Boşsa bu özellik sessizce devre dışı kalır.
ANTHROPIC_API_KEY=

# --- Sadece lokal geliştirme sunucusu (python app.py) ---
# FLASK_DEBUG=1 Flask debugger'ını açar. Debugger tarayıcıdan sunucuda KOD
# ÇALIŞTIRMAYA izin verir — asla erişilebilir bir makinede açık bırakma.
# FLASK_DEBUG=
# Varsayılan 127.0.0.1 (sadece bu bilgisayar). Ağdaki diğer cihazlardan
# erişmek için 0.0.0.0 yap.
# HOST=
